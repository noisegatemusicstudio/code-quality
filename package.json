{
  "name": "@releaseready/code-quality",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.3.0"
  },
  "files": [
    "dist/src",
    "src/osv-schema-LICENSE.txt",
    "src/osv-schema-NOTICE.txt",
    "README.md",
    "hooks/pre-commit",
    "quality.ignore"
  ],
  "exports": {
    "./eslint": "./dist/src/eslint.js",
    "./prettier": "./dist/src/prettier.js",
    "./lint-staged": "./dist/src/lint-staged.js",
    "./ignore": "./quality.ignore",
    "./check-paths": "./dist/src/check-paths.js",
    "./scan-report": "./dist/src/scan-report.js",
    "./eslint-import": "./dist/src/eslint-import.js",
    "./coverage-import": "./dist/src/coverage-import.js",
    "./customer-scan": "./dist/src/customer-scan.js",
    "./adapter-envelope": "./dist/src/adapter-envelope.js",
    "./scanner-adapter": "./dist/src/scanner-adapter.js"
  },
  "scripts": {
    "build": "tsc && node dist/src/build-assets.js",
    "import:report": "node dist/src/import-cli.js",
    "scan:committed": "node dist/src/scan-cli.js",
    "format": "prettier --ignore-path quality.ignore --write .",
    "format:check": "prettier --ignore-path quality.ignore --check .",
    "lint": "eslint . --max-warnings 0",
    "check:staged": "node dist/src/check-paths.js && lint-staged --config dist/src/lint-staged.js --hide-unstaged",
    "test": "node --test dist/tests/*.test.js",
    "check": "npm run build && npm run format:check && npm run lint && npm test",
    "prepare": "npm run build",
    "setup:dev": "npm run build && husky"
  },
  "prettier": "./dist/src/prettier.js",
  "dependencies": {
    "@eslint/js": "10.0.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "ignore": "7.0.14",
    "jiti": "2.7.0",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/yauzl": "3.4.0"
  },
  "overrides": {
    "eslint": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.1"
    }
  }
}
